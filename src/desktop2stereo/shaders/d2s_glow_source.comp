#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer RgbBuffer { float rgb[]; };
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D glow_image;
layout(set = 0, binding = 2, std430) writeonly buffer ScreenLightBuffer {
    vec4 screen_light_linear;
};
layout(set = 0, binding = 3, std430) buffer GlowHistoryBuffer {
    vec4 glow_history[];
};
layout(set = 0, binding = 4, std430) writeonly buffer EdgeLightBuffer {
    vec4 edge_light_linear[24];
};
layout(set = 0, binding = 5, std430) writeonly buffer CropDetectionBuffer {
    vec4 detected_crop_uv;
};

layout(push_constant) uniform GlowSourceParams {
    uint source_width;
    uint source_height;
    uint target_width;
    uint target_height;
    float prefilter_scale;
    uint surround_region_average;
    float temporal_alpha;
    uint write_glow;
    vec4 source_crop;
    uvec4 crop_detection;
} params;

uint source_pixel_count() {
    return params.source_width * params.source_height;
}

vec3 srgb_to_linear(vec3 encoded) {
    vec3 low = encoded / 12.92;
    vec3 high = pow((encoded + 0.055) / 1.055, vec3(2.4));
    return mix(low, high, greaterThan(encoded, vec3(0.04045)));
}

vec3 source_encoded_at(ivec2 coordinate) {
    int x = clamp(coordinate.x, 0, int(params.source_width) - 1);
    int y = clamp(coordinate.y, 0, int(params.source_height) - 1);
    uint pixel = uint(y) * params.source_width + uint(x);
    uint plane = source_pixel_count();
    return clamp(vec3(
            rgb[pixel], rgb[plane + pixel], rgb[2u * plane + pixel]),
            vec3(0.0), vec3(1.0));
}

vec2 crop_min_uv() {
    return clamp(params.source_crop.xy, vec2(0.0), vec2(0.9));
}

vec2 crop_size_uv() {
    vec2 minimum = crop_min_uv();
    return clamp(params.source_crop.zw, vec2(0.1), vec2(1.0) - minimum);
}

bool uniform_row(int y) {
    float total = 0.0;
    float squared = 0.0;
    for (int index = 0; index < 128; ++index) {
        float x = mix(float(params.source_width) * 0.10,
                      float(params.source_width) * 0.90,
                      (float(index) + 0.5) / 128.0);
        vec3 color = source_encoded_at(ivec2(int(x), y));
        float value = dot(color, vec3(0.2126, 0.7152, 0.0722));
        total += value;
        squared += value * value;
    }
    float mean = total / 128.0;
    return max(0.0, squared / 128.0 - mean * mean) < 0.000554;
}

bool uniform_column(int x) {
    float total = 0.0;
    float squared = 0.0;
    for (int index = 0; index < 128; ++index) {
        float y = mix(float(params.source_height) * 0.10,
                      float(params.source_height) * 0.90,
                      (float(index) + 0.5) / 128.0);
        vec3 color = source_encoded_at(ivec2(x, int(y)));
        float value = dot(color, vec3(0.2126, 0.7152, 0.0722));
        total += value;
        squared += value * value;
    }
    float mean = total / 128.0;
    return max(0.0, squared / 128.0 - mean * mean) < 0.000554;
}

vec4 detect_letterbox_crop() {
    int width = int(params.source_width);
    int height = int(params.source_height);
    if (width < 64 || height < 64) return vec4(0.0, 0.0, 1.0, 1.0);

    int top = 0;
    int bottom = 0;
    for (int index = 0; index < 360; ++index) {
        int y = (index * (height - 1)) / 359;
        if (!uniform_row(y)) break;
        top = y + 1;
    }
    for (int index = 0; index < 360; ++index) {
        int y = height - 1 - (index * (height - 1)) / 359;
        if (!uniform_row(y)) break;
        bottom = height - y;
    }
    int left = 0;
    int right = 0;
    for (int index = 0; index < 360; ++index) {
        int x = (index * (width - 1)) / 359;
        if (!uniform_column(x)) break;
        left = x + 1;
    }
    for (int index = 0; index < 360; ++index) {
        int x = width - 1 - (index * (width - 1)) / 359;
        if (!uniform_column(x)) break;
        right = width - x;
    }

    float center_total = 0.0;
    float center_bright = 0.0;
    for (int row = 0; row < 48; ++row) {
        int y = int(mix(float(height) * 0.35, float(height) * 0.65,
                        (float(row) + 0.5) / 48.0));
        for (int col = 0; col < 32; ++col) {
            int x = int(mix(float(width) * 0.10, float(width) * 0.90,
                            (float(col) + 0.5) / 32.0));
            float value = dot(source_encoded_at(ivec2(x, y)),
                              vec3(0.2126, 0.7152, 0.0722));
            center_total += value;
            center_bright += value > 0.0784 ? 1.0 : 0.0;
        }
    }
    float center_mean = center_total / (48.0 * 32.0);
    float bright_fraction = center_bright / (48.0 * 32.0);
    if (center_mean < 0.0549 && bright_fraction < 0.035) {
        return vec4(0.0, 0.0, 1.0, 1.0);
    }

    vec4 crop = vec4(0.0, 0.0, 1.0, 1.0);
    int min_y_bar = max(8, int(float(height) * 0.035));
    if (top >= min_y_bar && bottom >= min_y_bar && top + bottom < height) {
        int bigger = max(top, bottom);
        int smaller = min(top, bottom);
        if (bigger - smaller <= max(18, int(float(bigger) * 0.25))) {
            int trim = max(2, min(8, int(round(float(height) * 0.004))));
            int crop_top = min(height - 2, top + trim);
            int crop_bottom = max(crop_top + 1, height - bottom - trim);
            int crop_height = crop_bottom - crop_top;
            if (height - crop_height >= max(16, int(float(height) * 0.07))) {
                crop.y = float(crop_top) / float(height);
                crop.w = float(crop_height) / float(height);
            }
        }
    }
    int min_x_bar = max(8, int(float(width) * 0.035));
    if (left >= min_x_bar && right >= min_x_bar && left + right < width) {
        int bigger = max(left, right);
        int smaller = min(left, right);
        if (bigger - smaller <= max(18, int(float(bigger) * 0.25))) {
            int trim = max(2, min(8, int(round(float(width) * 0.004))));
            int crop_left = min(width - 2, left + trim);
            int crop_right = max(crop_left + 1, width - right - trim);
            int crop_width = crop_right - crop_left;
            if (width - crop_width >= max(16, int(float(width) * 0.07))) {
                crop.x = float(crop_left) / float(width);
                crop.z = float(crop_width) / float(width);
            }
        }
    }
    return crop;
}

vec3 reduce_screen_light_linear() {
    // A low-frequency stratified reduction is sufficient for reflected screen
    // illumination. This runs in Vulkan on the same source as Glow and writes
    // only one vec4 to host-visible coherent memory; no image is read back.
    vec3 total = vec3(0.0);
    for (uint sample_y = 0u; sample_y < 8u; ++sample_y) {
        for (uint sample_x = 0u; sample_x < 8u; ++sample_x) {
            vec2 sample_uv = (vec2(sample_x, sample_y) + vec2(0.5)) / 8.0;
            sample_uv = crop_min_uv() + sample_uv * crop_size_uv();
            ivec2 source_pixel = ivec2(floor(
                    sample_uv * vec2(params.source_width, params.source_height)));
            total += srgb_to_linear(source_encoded_at(source_pixel));
        }
    }
    return total / 64.0;
}

void main() {
    uvec2 output_pixel = gl_GlobalInvocationID.xy;
    if (output_pixel.x >= params.target_width || output_pixel.y >= params.target_height) {
        return;
    }

    if (all(equal(output_pixel, uvec2(0u)))) {
        screen_light_linear = vec4(reduce_screen_light_linear(), 1.0);
        if (params.crop_detection.x != 0u) {
            detected_crop_uv = detect_letterbox_crop();
        }
    }
    if (params.write_glow == 0u) {
        return;
    }

    vec2 output_uv = (vec2(output_pixel) + vec2(0.5)) /
            vec2(params.target_width, params.target_height);
    // Filament's uploaded CPU Glow texture follows the legacy OpenGL
    // bottom-left row convention. Mirror the top-left CUDA source here so the
    // external Vulkan image has the same sampling orientation.
    vec2 crop_minimum = crop_min_uv();
    vec2 crop_size = crop_size_uv();
    vec2 source_uv = crop_minimum + vec2(output_uv.x, 1.0 - output_uv.y) * crop_size;
    vec2 source_center = source_uv * vec2(params.source_width, params.source_height);
    vec2 base_footprint = crop_size * vec2(params.source_width, params.source_height) /
            vec2(params.target_width, params.target_height);
    // prefilter_scale is the legacy MIP footprint in source pixels, not a
    // multiplier of the already-downsampled 320x180 footprint.
    vec2 footprint = max(base_footprint, vec2(max(params.prefilter_scale, 1.0)));

    // Surround uses one average color for each 8 x 6 screen-edge segment. Keep
    // the 320 x 180 external image so the zero-copy ABI remains unchanged, but
    // sample the outer row / column from a narrow inward pixel band instead of
    // averaging an entire 1/8 x 1/6 screen block. Scale the band with source
    // resolution: about 4 px at 1080p, 8 px at 4K and 16 px at 8K.
    if (params.surround_region_average != 0u) {
        vec2 grid = vec2(8.0, 6.0);
        vec2 region = floor(clamp(output_uv, vec2(0.0), vec2(0.999999)) * grid);
        vec2 region_uv = (region + vec2(0.5)) / grid;
        source_uv = crop_minimum + vec2(region_uv.x, 1.0 - region_uv.y) * crop_size;
        source_center = source_uv * vec2(params.source_width, params.source_height);
        footprint = crop_size * vec2(params.source_width, params.source_height) / grid;

        float edge_band_pixels = clamp(
                round(float(min(params.source_width, params.source_height)) / 270.0),
                4.0, 16.0);
        if (region.x < 0.5) {
            source_center.x = crop_minimum.x * float(params.source_width) + edge_band_pixels * 0.5;
            footprint.x = edge_band_pixels;
        } else if (region.x > grid.x - 1.5) {
            source_center.x = (crop_minimum.x + crop_size.x) * float(params.source_width) - edge_band_pixels * 0.5;
            footprint.x = edge_band_pixels;
        }
        // output_uv is top-left based while the external Glow image follows
        // Filament's bottom-left convention, so the first output row samples
        // the source's bottom edge and the last row samples its top edge.
        if (region.y < 0.5) {
            source_center.y = (crop_minimum.y + crop_size.y) * float(params.source_height) - edge_band_pixels * 0.5;
            footprint.y = edge_band_pixels;
        } else if (region.y > grid.y - 1.5) {
            source_center.y = crop_minimum.y * float(params.source_height) + edge_band_pixels * 0.5;
            footprint.y = edge_band_pixels;
        }
    }

    // A fixed stratified 8x8 reduction bounds work independently of source
    // resolution. Veil uses scale 1, while Glow and Surround use the old
    // broad MIP footprint without creating CPU mipmaps.
    vec3 total = vec3(0.0);
    for (uint sample_y = 0u; sample_y < 8u; ++sample_y) {
        for (uint sample_x = 0u; sample_x < 8u; ++sample_x) {
            vec2 sample_offset = (vec2(sample_x, sample_y) + vec2(0.5)) / 8.0 - 0.5;
            ivec2 source_pixel = ivec2(floor(source_center + sample_offset * footprint));
            vec3 encoded = source_encoded_at(source_pixel);
            // A virtual surround surface should preserve perceptual black
            // levels. Average encoded sRGB only for Surround, then decode the
            // result once for Filament's linear workflow. Other Glow effects
            // retain their physical linear-radiance prefilter.
            total += params.surround_region_average != 0u
                    ? encoded : srgb_to_linear(encoded);
        }
    }
    vec3 average = total / 64.0;
    if (params.surround_region_average != 0u) {
        average = srgb_to_linear(average);
    }
    uint history_index = output_pixel.y * params.target_width + output_pixel.x;
    vec3 smoothed = average;
    if (params.temporal_alpha < 0.9999) {
        smoothed = mix(
            glow_history[history_index].rgb,
            average,
            clamp(params.temporal_alpha, 0.0, 1.0)
        );
    }
    glow_history[history_index] = vec4(smoothed, 1.0);
    // Publish the same GPU-smoothed colors used by Surround Glow. The order
    // is clockwise: top 8, right 4, bottom 8, left 4.
    if (params.surround_region_average != 0u) {
        uvec2 region = uvec2(floor(clamp(output_uv, vec2(0.0), vec2(0.999999)) * vec2(8.0, 6.0)));
        uvec2 representative = uvec2(floor((vec2(region) + vec2(0.5)) *
                vec2(params.target_width, params.target_height) / vec2(8.0, 6.0)));
        if (all(equal(output_pixel, representative))) {
            uint edge_index = 24u;
            if (region.y == 5u) edge_index = region.x;
            else if (region.x == 7u && region.y >= 1u && region.y <= 4u) edge_index = 12u - region.y;
            else if (region.y == 0u) edge_index = 12u + (7u - region.x);
            else if (region.x == 0u && region.y >= 1u && region.y <= 4u) edge_index = 20u + region.y - 1u;
            if (edge_index < 24u) edge_light_linear[edge_index] = vec4(smoothed, 1.0);
        }
    }
    imageStore(glow_image, ivec2(output_pixel), vec4(smoothed, 1.0));
}
